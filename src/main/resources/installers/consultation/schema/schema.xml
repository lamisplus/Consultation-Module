<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="autoIncrement" value="true"/>

    <changeSet id="202206010000000-0002" author="kennedy">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT count(*) FROM information_schema.tables WHERE table_name = 'consultation';
            </sqlCheck>
        </preConditions>
        <sqlFile dbms="postgresql"
                 path="consultation_tables.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"
                 stripComments="true"/>
    </changeSet>

    <changeSet id="20250722-01" author="victor">
        <preConditions onFail="MARK_RAN">
            <!-- Run only if 'signature' column does NOT already exist -->
            <not>
                <columnExists tableName="consultation" columnName="signature"/>
            </not>
        </preConditions>

        <addColumn tableName="consultation">
            <column name="signature" type="TEXT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

